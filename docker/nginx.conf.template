# Gabarit nginx : ${PORT} est remplace au demarrage par la valeur que Render
# impose au conteneur. Un port ecrit en dur ferait echouer le deploiement.

user www-data;
worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log /dev/stdout;
    sendfile   on;
    keepalive_timeout 65;

    # Les photos arrivent en base64 dans le corps JSON : une image de 5 Mo
    # pese pres de 7 Mo une fois encodee. La limite par defaut d'nginx est
    # de 1 Mo et rejetterait l'envoi avec une erreur 413.
    client_max_body_size 20m;

    gzip on;
    gzip_types application/json application/javascript text/css text/plain;

    server {
        listen ${PORT};
        server_name _;
        root /var/www/html/public;
        index index.php;

        charset utf-8;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        # Les fichiers deposes (avatars, publications, photos de metiers) sont
        # servis par nginx, sans passer par PHP.
        location /storage {
            try_files $uri $uri/ =404;
            expires 7d;
            add_header Cache-Control "public";
        }

        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include fastcgi_params;

            fastcgi_read_timeout 60;
        }

        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
