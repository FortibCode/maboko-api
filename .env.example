APP_NAME="MABOKO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de donnees (§6.2 : PostgreSQL) -----------------------------------
# Les services correspondants sont fournis par compose.yaml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=maboko
DB_USERNAME=maboko
DB_PASSWORD=maboko

# --- Cache, sessions, files d'attente (§6.2 : Redis) -----------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Envoi des SMS (OTP, repli quand la notification push echoue) ----------
# log    : le code part dans storage/logs/laravel.log (developpement)
# twilio : envoi reel
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# DEVELOPPEMENT UNIQUEMENT.
# A true, le code OTP est renvoye dans la reponse HTTP, ce qui supprime de fait
# la verification par telephone. Doit imperativement rester a false en production.
OTP_EXPOSE_IN_RESPONSE=false

# --- Stockage media (§6.2 : S3 ou equivalent) ------------------------------
AWS_ACCESS_KEY_ID=maboko
AWS_SECRET_ACCESS_KEY=mabokosecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=maboko
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@maboko.cg"
MAIL_FROM_NAME="${APP_NAME}"
