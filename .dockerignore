# Ce qui n'a rien a faire dans l'image.
#
# Attention aux dossiers de « storage » : Docker ne cree pas de repertoire
# vide, et exclure leur contenu ferait disparaitre le dossier lui-meme. Or
# « view:cache » echoue si storage/framework/views n'existe pas. Seuls les
# fichiers sont donc exclus, jamais les marqueurs .gitignore qui tiennent
# l'arborescence.
.git
.github
.env
.env.*
vendor
node_modules
tests
phpunit.xml
phpstan.neon
.phpunit.result.cache
compose.yaml

storage/logs/*.log
storage/framework/cache/data/*.php
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*.php

# Les fichiers deposes ne voyagent pas dans l'image : ils vivent sur le
# stockage persistant du service.
storage/app/public/**/*.png
storage/app/public/**/*.jpg
storage/app/public/**/*.jpeg
storage/app/public/**/*.webp
storage/app/private/**/*.chiffre
public/storage
